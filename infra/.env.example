# Copy to infra/.env and fill in real values. Never commit infra/.env.
#
# Generate the two secrets below before starting the stack:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── PostgreSQL container ──────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-password
POSTGRES_DB=cloudguard

# Backend -> PostgreSQL. Use the Compose service name, not localhost.
DATABASE_URL=postgresql+asyncpg://admin:replace-with-a-password@postgres:5432/cloudguard

# ── MongoDB (policy documents) ────────────────────────────────
MONGO_URI=mongodb://mongo:27017
DATABASE_NAME=cloudgaurdscanner

# ── Secrets ───────────────────────────────────────────────────
# At least 32 characters. The API refuses to start without it.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Encrypts cloud-account credentials at rest. A urlsafe-base64 32-byte Fernet
# key. To rotate, put the new key first: NEW_KEY,OLD_KEY
CREDENTIALS_ENCRYPTION_KEY=

# Leave false once the first platform operator exists; it keeps
# POST /root_user/register closed.
ALLOW_ROOT_REGISTRATION=false

# Browser origins allowed to call the API. The default covers localhost and any
# tenant subdomain of it. Narrow this to your own hosts in production.
# CORS_ALLOW_ORIGIN_REGEX=^https://([A-Za-z0-9-]+\.)?cloudguard\.example\.com$

# ── AWS defaults ──────────────────────────────────────────────
# Scans use the per-cloud-account credentials stored in the database.
# These are only region hints.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# ── Email ─────────────────────────────────────────────────────
# Temporary passwords for new accounts are delivered by email only, so set up
# SMTP before creating users. With MAIL_SUPPRESS_SEND=true the message is just
# logged and the password cannot be recovered.
MAIL_SUPPRESS_SEND=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_FROM_NAME=CloudGuard
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
SUPPORT_URL=
PRIVACY_URL=

# ── URLs ──────────────────────────────────────────────────────
# Used to build tenant sign-in links in emails: http://<slug>.localhost:3000/login
FRONT_END_URL=http://localhost:3000

# Frontend -> backend. Keep NEXT_PUBLIC_BACKEND_URL and NEXT_PUBLIC_BACKEND
# UNSET. Setting either makes the browser call the backend cross-origin from a
# tenant subdomain; leaving them unset keeps every call same-origin through the
# Next.js rewrite.
BACKEND_INTERNAL_URL=http://server:8000

# Production only: apex domain used to resolve the tenant slug.
# NEXT_PUBLIC_ROOT_DOMAIN=cloudguard.example.com
